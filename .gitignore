.venv/
__pycache__/
*.pyc
exports/
test-output/
tools/
private/
*.log

# Cartridge drivers are fetched upstream by setup; do not redistribute their bytes.
chrono/resources/*-driver.bin
chrono/resources/bus-raster.asm
chrono/resources/bus128.asm
chrono/resources/bus128-line.asm
chrono/resources/sprites-dpc.asm
chrono/resources/pair-dpc.asm
chrono/resources/sprites-cdfj.asm
chrono/resources/pair-cdfj.asm

# Native matcher compiler intermediates (C source and DLL are retained).
chrono/native/*.obj
chrono/native/*.lib
chrono/native/*.exp
